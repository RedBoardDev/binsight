{
  "openapi": "3.1.0",
  "info": {
    "title": "binsight",
    "description": "The HTTP API of a binsight server: health, authentication and live events.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs the owner in with the password and sets the session cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "400": {
            "description": "The body is not a valid login request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "The password is wrong (`invalid_credentials`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "A cross-site request (`forbidden_cross_origin`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts (`too_many_attempts`); retry after the delay.",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                },
                "description": "Seconds to wait before the next attempt."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out: deletes the session cookie. Always succeeds, signed in or not.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; the session cookie is deleted."
          },
          "403": {
            "description": "A cross-site request (`forbidden_cross_origin`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The current session, if the session cookie is valid.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in (`unauthenticated`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "live"
        ],
        "summary": "Streams the live events of the server.",
        "operationId": "streamEvents",
        "responses": {
          "200": {
            "description": "A stream of Server-Sent Events. The `event:` name of each message equals the `type` of its JSON `data`. `engine_status` comes first, then a `heartbeat` every 15 seconds and the other events as they happen.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/LiveEvent"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in (`unauthenticated`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Reports the health of the server.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The server and its database answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Serves the contract.",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "This contract, as OpenAPI 3.1 JSON.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentStatus": {
        "type": "string",
        "description": "Whether one component answers.",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "EngineStatus": {
        "type": "string",
        "description": "Where the engine is in its lifecycle.",
        "enum": [
          "starting",
          "running",
          "stopping"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "What went wrong."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Why a request failed. Stable: clients use it as their translation key.",
        "enum": [
          "invalid_request",
          "unauthenticated",
          "invalid_credentials",
          "forbidden_cross_origin",
          "not_found",
          "method_not_allowed",
          "request_timeout",
          "payload_too_large",
          "too_many_attempts",
          "internal"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "description": "The content of an error body.",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "The stable error code; clients translate it."
          },
          "message": {
            "type": "string",
            "description": "An English explanation for debugging; never shown to users as is."
          },
          "request_id": {
            "type": "string",
            "description": "The id of the request, also in the `x-request-id` response header."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "The health report.",
        "required": [
          "status",
          "version",
          "database",
          "engine"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ComponentStatus",
            "description": "Whether the database answers."
          },
          "engine": {
            "$ref": "#/components/schemas/EngineStatus",
            "description": "Where the engine is in its lifecycle."
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "description": "`ok` when every component answers."
          },
          "version": {
            "type": "string",
            "description": "The binsight version, for example `0.1.0`."
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "description": "The overall verdict of a health check.",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "LiveEvent": {
        "oneOf": [
          {
            "type": "object",
            "description": "Sent every 15 seconds so clients can tell a quiet stream from a dead one.",
            "required": [
              "server_time",
              "type"
            ],
            "properties": {
              "server_time": {
                "type": "string",
                "format": "date-time",
                "description": "The server's clock (RFC 3339, UTC)."
              },
              "type": {
                "type": "string",
                "enum": [
                  "heartbeat"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The engine's lifecycle status: sent first on every connection, then on each change.",
            "required": [
              "status",
              "type"
            ],
            "properties": {
              "status": {
                "$ref": "#/components/schemas/EngineStatus",
                "description": "The new status."
              },
              "type": {
                "type": "string",
                "enum": [
                  "engine_status"
                ]
              }
            }
          }
        ],
        "description": "A message of the live event stream."
      },
      "LoginRequest": {
        "type": "object",
        "description": "A login attempt. Deliberately not `Debug`: it holds the password.",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "description": "The owner's password."
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "description": "The current session.",
        "required": [
          "authenticated",
          "expires_at"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "Always `true`: without a session the API answers `401` instead."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the session ends (RFC 3339, UTC); the owner must then sign in again."
          }
        }
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "binsight_session"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "The state of the server and its contract."
    },
    {
      "name": "auth",
      "description": "Signing in and out with the owner's password."
    },
    {
      "name": "live",
      "description": "Events pushed to the clients as they happen."
    }
  ]
}
