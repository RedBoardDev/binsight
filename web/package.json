{
  "name": "binsight-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/thirdPartyNotices.ts",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "test": "tsr generate && vitest run",
    "test:watch": "vitest",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync --clean && lingui check missing",
    "openapi:generate": "openapi-typescript ../openapi/v1.json --output src/lib/api/generated/openapi.d.ts",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- src/lib/api/generated",
    "licenses:check": "node scripts/thirdPartyNotices.ts --check",
    "e2e": "playwright test",
    "budget": "node scripts/bundleBudget.ts",
    "visual": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "5.9.1",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "lucide-react": "1.50.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
