{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2025.Intl", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "paths": {
      "@app/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/app.tsbuildinfo"
  },
  "include": ["src", "test"],
  "exclude": ["src/sw", "test/**/*.spec.ts", "test/architecture", "test/designRules"]
}
