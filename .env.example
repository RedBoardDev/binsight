# ─── Binsight — configuration ─────────────────────────────────────────────
# Copy to .env (`make setup` does it) and fill the two REQUIRED values.
# Production: the API reads .env.prod (env_file); the host .env next to
# docker-compose.prod.yml only needs POSTGRES_PASSWORD (see deploy/README.md).

# ─── Required ─────────────────────────────────────────────────────────────
# Signs every session JWT (HS256). ≥32 chars, keep it stable: changing it
# signs everyone out. Generate: openssl rand -hex 32
AUTH_SECRET=
# Solana WebSocket endpoint (a Helius wss:// URL; the free plan works).
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HTTP RPC endpoint. Optional: derived from SOLANA_WS_URL when unset.
# SOLANA_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ─── Accounts ─────────────────────────────────────────────────────────────
# The owner's wallet address: whitelisted at boot, owner rights when it
# registers (by signing). Empty = no owner seeded.
OWNER_ADDRESS=
# 'true' = register with address + password only (no signature, no
# whitelist), single-wallet accounts, notifications off. The owner address
# still registers by signing.
OPEN_ACCESS_MODE=false

# ─── Server ───────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
# Browser origins allowed by CORS and on the /live WebSocket (comma-separated).
# The first one also binds the sign-in message to this app.
WEB_ORIGINS=http://localhost:3000
# Local Postgres from `make db-up` (docker-compose.yml, host port 5435).
DATABASE_URL=postgres://meteora:meteora@localhost:5435/meteora
# Production host .env only (docker-compose.prod.yml refuses to start without it):
# POSTGRES_PASSWORD=

# ─── RPC budget (Helius free-plan defaults) ───────────────────────────────
# Plan limits in requests/second; the API targets 85% of each.
SOLANA_RPS=10
SOLANA_GPA_RPS=5
SOLANA_DAS_RPS=2
SOLANA_SEND_RPS=1
# Share of the overall budget reserved for live snapshots (the rest: history ingest).
SOLANA_LIVE_FRACTION=0.6
# First-ever history backfills allowed at once.
BACKFILL_CONCURRENCY=3
# Bound a new wallet's backfill to its last N days (0 = full history).
INGEST_SINCE_DAYS=0
# Chained-FIFO realized PnL (reads persisted legs/swaps). 'false' = keep the
# persisted figures, new closes show the pool mark.
REALIZED_PNL_ENABLED=true

# ─── Prices ───────────────────────────────────────────────────────────────
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3

# ─── Notifications ────────────────────────────────────────────────────────
# Bark = push fallback when no client is active. Empty disables it (the key
# can also be changed at runtime by the owner via /config/settings).
BARK_KEY=
BARK_BASE_URL=https://api.day.app
# A client counts as "active" this long after its last presence heartbeat.
PRESENCE_TIMEOUT_SECONDS=30
# Web Push (PWA). Generate once: npx web-push generate-vapid-keys
# Keep them stable (subscriptions are bound to the public key). Empty = off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@binsight.local

# ─── Web (Next.js) ────────────────────────────────────────────────────────
# Server-side BFF → API. Defaults to http://localhost:8787 in dev.
# API_URL=http://localhost:8787
# Origin the browser opens the /live WebSocket on (baked at build time).
# NEXT_PUBLIC_API_WS_URL=ws://localhost:8787

# ─── macOS app ────────────────────────────────────────────────────────────
# API URL baked into the app by `make install-mac` (overridable in its
# Settings). Use the Mac's LAN/Tailscale address to reach another machine.
CLIENT_API_URL=http://localhost:8787
