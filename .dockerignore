# Keep the build context small and never copy host artefacts or secrets into an image.
.git
node_modules
**/node_modules
.yarn/cache
.yarn/install-state.gz
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo
data
**/*.log
# Env files at ANY depth (the root .env/.env.prod, a web/.env.local Next.js would otherwise read at
# build time, …). No image needs .env.example either: the Dockerfiles never copy it.
**/.env
**/.env.*
docs
apps
scripts
.claude
.serena
**/.DS_Store
